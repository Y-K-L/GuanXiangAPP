.page { padding: 32rpx; min-height: 100vh; box-sizing: border-box; }
.header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.title { font-size: 44rpx; font-weight: 700; }
.count { font-size: 24rpx; color: #6B6B6B; }

.section-label { font-size: 28rpx; font-weight: 600; margin: 32rpx 0 16rpx; color: #1F1F1F; }

.trigram-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16rpx; }
.trigram-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 0;
  text-align: center;
  box-shadow: 0 4rpx 24rpx rgba(31,31,31,0.04);
}
.trigram-symbol { font-size: 44rpx; color: #2B2B2B; }
.trigram-name { font-size: 22rpx; color: #6B6B6B; margin-top: 4rpx; }

.hex-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; }
.hex-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 0;
  text-align: center;
  box-shadow: 0 4rpx 24rpx rgba(31,31,31,0.04);
}
.hex-card.off { background: #D9D4C8; opacity: 0.6; }
.hex-name { font-size: 30rpx; font-weight: 600; color: #1F1F1F; }
.hex-card.off .hex-name { color: #8C8578; }
.hex-full { font-size: 20rpx; color: #6B6B6B; margin-top: 4rpx; }
.hex-card.off .hex-full { color: #8C8578; }
