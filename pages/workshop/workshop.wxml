<view class="page">
  <view class="header">
    <view class="back" bindtap="reset">↺</view>
    <view class="title">爻线工坊</view>
    <view class="reset" bindtap="reset">重置</view>
  </view>

  <view class="hint">点按任意爻线，阳变阴、阴变阳</view>

  <view class="hexagram-card">
    <block wx:for="{{lines}}" wx:key="index">
      <view class="line-item" data-index="{{index}}" bindtap="tapLine">
        <view wx:if="{{item === 'yang'}}" class="line yang"></view>
        <view wx:else class="line yin">
          <view class="yin-part"></view>
          <view class="yin-gap"></view>
          <view class="yin-part"></view>
        </view>
      </view>
    </block>
  </view>

  <view class="info">
    <view class="hexagram-name">{{hexagramName}}</view>
    <view wx:if="{{upperSymbol}}" class="trigram-pair">上卦 {{upperSymbol}} {{upperNature}} · 下卦 {{lowerSymbol}} {{lowerNature}}</view>
    <view class="plain">{{plain}}</view>
  </view>

  <view class="actions">
    <button class="btn ghost" bindtap="randomChange">随机一变</button>
    <button class="btn primary" bindtap="saveToCollection">收入图鉴</button>
  </view>
</view>
