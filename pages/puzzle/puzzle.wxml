<view class="page">
  <view class="prompt">{{level.prompt}}</view>

  <block wx:if="{{level.type === 'composeByName'}}">
    <view class="slots">
      <view class="slot {{upperSel ? 'filled' : ''}} {{focus === 'upper' ? 'focus' : ''}}">
        <view class="slot-label">上卦</view>
        <view class="slot-value">{{upperSel ? upperSel : '点击下方八卦选择'}}</view>
      </view>
      <view class="slot {{lowerSel ? 'filled' : ''}} {{focus === 'lower' ? 'focus' : ''}}">
        <view class="slot-label">下卦</view>
        <view class="slot-value">{{lowerSel ? lowerSel : '点击下方八卦选择'}}</view>
      </view>
    </view>
  </block>

  <view class="palette">
    <block wx:for="{{trigrams}}" wx:key="id">
      <view
        class="tile {{upperSel === item.id ? 'selected' : ''}}"
        data-id="{{item.id}}"
        bindtap="selectTrigram"
      >
        <view class="tile-symbol">{{item.symbol}}</view>
        <view class="tile-name">{{item.name}}</view>
      </view>
    </block>
  </view>

  <view wx:if="{{submitted}}" class="result {{correct ? 'ok' : 'no'}}">
    <view class="result-title">{{correct ? '✓ 正确' : '✗ 再试一次'}}</view>
    <view class="result-expl">{{level.explanation}}</view>
  </view>

  <view class="actions">
    <button wx:if="{{!submitted}}" class="btn primary" bindtap="submit">提交</button>
    <button wx:if="{{submitted}}" class="btn primary" bindtap="next">下一关</button>
  </view>
</view>
