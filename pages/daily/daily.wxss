.page { min-height: 100vh; padding: 32rpx; box-sizing: border-box; display: flex; flex-direction: column; }
.date { font-size: 24rpx; color: #6B6B6B; margin-bottom: 16rpx; }

.scenario {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #3A3A3A;
  box-shadow: 0 4rpx 24rpx rgba(31,31,31,0.04);
  margin-bottom: 32rpx;
}

.question { font-size: 32rpx; font-weight: 600; margin-bottom: 16rpx; }

.options { display: flex; flex-direction: column; gap: 16rpx; }
.option {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  border: 2rpx solid transparent;
  box-shadow: 0 4rpx 24rpx rgba(31,31,31,0.04);
}
.option.selected { border-color: #8B5E3C; background: #FAF5EE; }
.option.correct { border-color: #4F7A5A; background: #E4EFE6; }
.option.wrong { border-color: #B54A3A; background: #F1E3E0; }
.option-text { font-size: 28rpx; color: #1F1F1F; }

.explain {
  margin-top: 32rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #EFE9DC;
}
.explain-title { font-size: 30rpx; font-weight: 600; margin-bottom: 8rpx; color: #8B5E3C; }
.explain-body { font-size: 26rpx; color: #3A3A3A; line-height: 1.7; }

.actions { margin-top: auto; padding-bottom: 48rpx; }
.btn { height: 88rpx; line-height: 88rpx; border-radius: 999rpx; font-size: 30rpx; text-align: center; }
.btn.primary { background: #8B5E3C; color: #FFFFFF; }
.btn.ghost { background: transparent; color: #8B5E3C; border: 2rpx solid #8B5E3C; }
